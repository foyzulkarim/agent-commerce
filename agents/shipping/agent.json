{
  "name": "shipping",
  "queue": "shipping-agent",
  "consumes": ["order.confirmed", "address.provided", "payment.authorized"],
  "emits": ["shipment.quoted", "shipment.booked", "shipment.failed"],
  "tools": ["geocode", "quote", "book"],
  "limits": { "max_calls": 6, "max_tokens": 4096, "timeout_ms": 60000, "effort": "low" }
}
