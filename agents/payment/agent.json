{
  "name": "payment",
  "queue": "payment-agent",
  "consumes": ["shipment.quoted", "shipment.dispatched", "shipment.failed"],
  "emits": ["payment.authorized", "payment.captured", "payment.failed"],
  "tools": ["authorize", "capture", "void"],
  "limits": { "max_calls": 6, "max_tokens": 4096, "timeout_ms": 60000, "effort": "low" }
}
