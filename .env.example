# Copy to .env. docker compose and scripts/dev-host.sh read it.
ANTHROPIC_API_KEY=
MODEL_NAME=claude-opus-5-5
# AGENT_MODE=scripted runs the six agents with fixed rules (agents/*/scripted.ts): no model, no key. Demo fallback.
AGENT_MODE=
LOG_LEVEL=info
# Timer (orders). Minutes, short for the demo.
TIMER_INTERVAL=30s
OFFER_TTL=10
WATCH_TTL=60
ADDRESS_TTL=10
# Only behind a proxy that intercepts TLS: the proxy CA certificate, for npm ci in the image build.
# Copy the certificate into this folder (git ignores npm-ca.pem), then set NPM_CA_FILE=./npm-ca.pem
NPM_CA_FILE=
