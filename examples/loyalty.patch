diff --git a/agent-commerce/services/loyalty/src/main.ts b/agent-commerce/services/loyalty/src/main.ts
new file mode 100644
index 0000000..d731f0c
--- /dev/null
+++ b/agent-commerce/services/loyalty/src/main.ts
@@ -0,0 +1,46 @@
+import path from "node:path";
+import { connectBus } from "@ac/bus";
+import { query, startDatabase } from "@ac/db";
+import { type EventType, newEvent } from "@ac/events";
+import { log } from "@ac/log";
+import { createApp, registerMcp } from "@ac/mcp-kit";
+import { loyaltyTools } from "./tools.ts";
+
+const logger = log("loyalty");
+const PORT = Number(process.env.PORT ?? 3000);
+const here = import.meta.dirname;
+
+/** The events this service reacts to (design §12 part 2). Each name becomes one RabbitMQ binding. */
+const CONSUMES: EventType[] = ["shipment.delivered"];
+
+const pool = await startDatabase({
+  databaseUrl: process.env.DATABASE_URL ?? "postgres://ac:ac@postgres:5432/loyalty",
+  migrationsDir: path.join(here, "..", "migrations"),
+  seedDir: path.join(here, "..", "seed"),
+  log: logger,
+});
+
+const bus = await connectBus(process.env.AMQP_URL ?? "amqp://ac:ac@rabbitmq:5672", logger);
+
+if (CONSUMES.length > 0) {
+  await bus.consume("loyalty", CONSUMES, async (event) => {
+    await query(
+      pool,
+      "INSERT INTO loyalty_events_seen (event_id, event_type) VALUES ($1, $2) ON CONFLICT DO NOTHING",
+      [event.event_id, event.type],
+    );
+    logger.info({ type: event.type, event_id: event.event_id }, "event seen");
+    if (event.type === "shipment.delivered") {
+      await bus.publish(
+        newEvent({ type: "points.awarded", payload: { points: 10 }, draft_id: event.draft_id }),
+      );
+    }
+  });
+}
+
+const app = createApp();
+app.get("/health", async () => ({ ok: true, service: "loyalty" }));
+registerMcp(app, { name: "loyalty", tools: loyaltyTools(pool), log: logger });
+
+await app.listen({ port: PORT, host: "0.0.0.0" });
+logger.info({ port: PORT, consumes: CONSUMES }, "loyalty listening; MCP on /mcp");
diff --git a/agent-commerce/services/loyalty/src/tools.ts b/agent-commerce/services/loyalty/src/tools.ts
new file mode 100644
index 0000000..938b6da
--- /dev/null
+++ b/agent-commerce/services/loyalty/src/tools.ts
@@ -0,0 +1,31 @@
+import { type Pool, query } from "@ac/db";
+import { defineTool, GuardError } from "@ac/mcp-kit";
+import { z } from "zod";
+
+/** The MCP tools of loyalty. A guard runs in the server; the agent only asks. */
+export function loyaltyTools(pool: Pool) {
+  const countSeen = defineTool({
+    name: "loyalty_count_seen",
+    description: "Returns how many events loyalty has seen. Read only; no guard.",
+    input: z.object({}),
+    run: async () => {
+      const result = await query<{ n: string }>(
+        pool,
+        "SELECT count(*)::text AS n FROM loyalty_events_seen",
+      );
+      return { seen: Number(result.rows[0]?.n ?? 0) };
+    },
+  });
+
+  const example = defineTool({
+    name: "loyalty_example",
+    description: "An example of a guarded tool. Replace it.",
+    input: z.object({ amount: z.number().int().nonnegative() }),
+    guard: ({ amount }) => {
+      if (amount > 1000) throw new GuardError("amount above 1000 is not allowed");
+    },
+    run: async ({ amount }) => ({ accepted: amount }),
+  });
+
+  return [countSeen, example];
+}
